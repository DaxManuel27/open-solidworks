{
  "name": "openforge-monorepo",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @openforge/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:assistant": "node scripts/assistant-test.mjs",
    "bench": "node scripts/bench.mjs replay reference",
    "conformance": "node scripts/catalog-conformance.mjs",
    "perf": "node scripts/phase-2-performance.mjs",
    "perf:check": "node scripts/phase-2-performance.mjs --check",
    "perf:asm": "node scripts/phase-3-performance.mjs",
    "perf:asm:check": "node scripts/phase-3-performance.mjs --check",
    "perf:draw": "node scripts/phase-4-performance.mjs",
    "perf:draw:check": "node scripts/phase-4-performance.mjs --check",
    "perf:phase5": "node scripts/phase-5-performance.mjs",
    "perf:phase5:check": "node scripts/phase-5-performance.mjs --check",
    "perf:phase6": "node scripts/phase-6-performance.mjs",
    "perf:phase6:check": "node scripts/phase-6-performance.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module"
}
